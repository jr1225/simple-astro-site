---
import '../styles/global.css'
import ThemeToggle from './ThemeToggle.jsx'
---

<div class="h-screen w-screen">
  <div class="flex h-full w-full justify-center items-center">
    <div class="md:flex">

      <div class="md:shrink-0 flex justify-center items-center p-5">
        <a href="https://github.com/jr1225">
          <img
            class="h-50 w-50 md:h-50 md:w-50 rounded-full transition-all
                   duration-300 hover:scale-110"
            src='https://avatars.githubusercontent.com/u/121626681?v=4'
            alt='profile picture'
          />
        </a>
      </div>

      <div class="p-10 md:p-5 max-w-160">

        <div class="flex items-center">
          <h1 class="text-5xl font-extrabold">Jean.R</h1>
          <div class="h-4 pl-5"><ThemeToggle client:load /></div>
        </div>
        <h1 class="text-2xl text-(--color-foreground-s)">Junior Developer</h1>
        <p class="pt-2 text-sm md:text-base">
        Hey! I'm Jean, currently studying at ISEP in France.<br>
        I'm pasionate about dev and art in general.
        I mainly code in python and rust, I enjoy learning new programing language depending on what I need.
        </p>

        <div class="h-3"></div>
        <div class="flex gap-8 text-text-1 text-sm md:text-base">
          <a href="https://github.com/jr1225" class="hover:underline">
            [ github : @jr1225 ]
          </a>
          <a href="mailto:jean.rte@proton.me" class="hover:underline">
            [ email : jean.rte@proton.me ]
          </a>
        </div>

      </div>

    </div>
  </div>
</div>

